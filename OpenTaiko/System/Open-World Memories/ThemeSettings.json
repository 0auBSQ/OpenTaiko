  {
    "id": "songselect_key_help",
    "type": "key",
    "scope": "global",
    "label": {
      "strings": {
        "default": "Song select: show shortcuts",
        "ja": "選曲: ショートカット一覧",
        "fr": "Sélection : afficher les raccourcis",
        "de": "Songauswahl: Tastenkürzel anzeigen",
        "es": "Selección: mostrar atajos",
        "ko": "곡 선택: 단축키 보기",
        "zh": "选曲：显示快捷键"
      }
    },
    "description": {
      "strings": {
        "default": "Opens the list of the song select's keyboard shortcuts.",
        "ja": "選曲画面のキーボードショートカット一覧を開きます。",
        "fr": "Ouvre la liste des raccourcis clavier de la sélection de chanson.",
