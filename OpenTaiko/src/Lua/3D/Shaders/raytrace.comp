}

// Shadow-ray test toward a light, t in (tmin, tmax). With passEmis, emissive surfaces let it through: toward a point
// light or an emissive sphere they stand for the light itself, so a lamp can sit inside its bulb. The sun's ray
// passes false: emissive surfaces cast sun shadows.
bool occluded(vec3 o, vec3 d, float tmin, float tmax, bool passEmis){
    if(anyTri(o,d,tmin,tmax,passEmis)) return true;
    for(int i=0;i<uNumPrim;i++){
        int b=i*PRM; int kind=int(top[b]);
        if(passEmis && emissiveMat(int(top[b+14]))) continue;
        if(kind==0){ vec3 c=vec3(top[b+1],top[b+2],top[b+3]); float rad=top[b+4]; vec3 oc=o-c; float bb=dot(oc,d), cc=dot(oc,oc)-rad*rad; float disc=bb*bb-cc; if(disc<0.0) continue; float sq=sqrt(disc); float tt=-bb-sq; if(tt<=tmin) tt=-bb+sq; if(tt>tmin&&tt<tmax) return true; }
        else if(kind==1){ vec3 nrm=vec3(top[b+4],top[b+5],top[b+6]); float den=dot(d,nrm); if(abs(den)<1e-9) continue; float tt=dot(vec3(top[b+1],top[b+2],top[b+3])-o,nrm)/den; if(tt>tmin&&tt<tmax) return true; }
        else if(kind==2){ vec3 bmin=vec3(top[b+7],top[b+8],top[b+9]), bmax=vec3(top[b+10],top[b+11],top[b+12]); float tt; vec3 bn; if(boxHit(o,d,bmin,bmax,tmin,tmax,tt,bn)) return true; }
    }
#ifdef HAS_SDF
    if(marchAny(o,d,tmin,tmax,passEmis)) return true;
#endif
    return false;
}

// an orthonormal pair perpendicular to the unit vector w
void frame(vec3 w, out vec3 u, out vec3 v){ vec3 a=(abs(w.x)>0.9)?vec3(0.0,1.0,0.0):vec3(1.0,0.0,0.0); u=safeNorm(cross(a,w)); v=cross(w,u); }
// v turned to the side of nf: unchanged above the surface, mirrored across it below
vec3 above(vec3 v, vec3 nf){ float k=dot(v,nf); return k>0.0 ? v : v-nf*(2.0*k); }
// 1 - cos of the half angle of the cone that the sphere (c, r) fills seen from p; 0 from inside it
float coneOmc(vec3 p, vec3 c, float r){
    vec3 v=c-p; float d2=dot(v,v), r2=r*r;
    if(d2<=r2) return 0.0;
    float s2=r2/d2; return s2/(1.0+sqrt(1.0-s2));
}

// Next-event estimation for a diffuse hit at p with shading normal n and surface normal nf on the ray's side (e: the
// offset at p): the point lights, the sun, and one direction toward each emissive sphere, drawn uniformly in the cone
// the sphere fills and weighted against the cosine bounce that can reach it too (power heuristic, see bounceWeight).
vec3 directLight(vec3 p, vec3 n, vec3 nf, float e, inout uint seed){
    vec3 sum=vec3(0.0), po=p+nf*e;
    for(int i=0;i<uNumLight;i++){
        int b=uLightOff+i*LGT; vec3 lp=vec3(aux[b],aux[b+1],aux[b+2]);
        vec3 to=lp-p; float dist=length(to); if(dist<1e-6) continue;
        vec3 l=to/dist; float ndl=dot(n,l); if(ndl<=0.0 || dot(nf,l)<=0.0) continue;
        if(occluded(po, l, e, dist-20.0*e, true)) continue;
        float inv=ndl/(PI*max(dist*dist,MIN_LIGHT_D2));
        sum += vec3(aux[b+3],aux[b+4],aux[b+5])*inv;
    }
    if(uSunCol.x+uSunCol.y+uSunCol.z>0.0){   // the sun: a direction, its shadow ray runs to infinity
        float ndl=dot(n,uSunDir);
        if(ndl>0.0 && dot(nf,uSunDir)>0.0 && !occluded(po, uSunDir, e, NOHIT, false)) sum += uSunCol*ndl;
    }
    for(int i=0;i<uNumPrim;i++){
        int b=i*PRM; int m=int(top[b+14]);
        if(int(top[b])!=0 || !emissiveMat(m)) continue;
        vec3 c=vec3(top[b+1],top[b+2],top[b+3]); float r=top[b+4];
        float omc=coneOmc(p,c,r); if(omc<=0.0) continue;
        vec3 w=safeNorm(c-p), tu, tv; frame(w,tu,tv);
        float om=nextd(seed)*omc, ph=2.0*PI*nextd(seed), st=sqrt(max(0.0,om*(2.0-om)));
        vec3 l=safeNorm(tu*(st*cos(ph))+tv*(st*sin(ph))+w*(1.0-om));
        float ndl=dot(n,l); if(ndl<=0.0 || dot(nf,l)<=0.0) continue;
        vec3 oc=p-c; float bq=dot(oc,l), tl=-bq-sqrt(max(bq*bq-(dot(oc,oc)-r*r),0.0));
        if(occluded(po, l, e, tl-e, true)) continue;
        // emission * (cos/PI) / pdf, times the light's weight pl^2/(pl^2+pb^2), with q = pb/pl
        float q=2.0*ndl*omc;
        sum += vec3(aux[m*MTL+6],aux[m*MTL+7],aux[m*MTL+8])*(q/(1.0+q*q));
    }
    return sum;
}
// The share of the emission that a cosine bounce from the diffuse vertex (pp, normals pn, pnf) in direction d finds
// on primitive i, when directLight there sampled it too (an emissive sphere): pb^2/(pb^2+pl^2). 1 for a direction
// directLight cannot draw.
float bounceWeight(int i, vec3 pp, vec3 pn, vec3 pnf, vec3 d){
    int b=i*PRM;
    if(int(top[b])!=0) return 1.0;
    float omc=coneOmc(pp,vec3(top[b+1],top[b+2],top[b+3]),top[b+4]), ndl=dot(pn,d);
    if(omc<=0.0 || ndl<=0.0 || dot(pnf,d)<=0.0) return 1.0;
    float q=2.0*ndl*omc;
    return q*q/(1.0+q*q);
}

#ifdef HAS_NMAP
uint vhash(int x,int y,int z){ int v=x*374761393+y*668265263+z*1274126177; uint h=uint(v); h=(h^(h>>13))*1274126177u; return (h^(h>>16))&0xffffffu; }
float vhashf(int x,int y,int z){ return float(vhash(x,y,z))/16777216.0; }
float noise3(vec3 p){
    int xi=int(floor(p.x)),yi=int(floor(p.y)),zi=int(floor(p.z));
    float fx=p.x-float(xi),fy=p.y-float(yi),fz=p.z-float(zi);
    float sx=fx*fx*(3.0-2.0*fx),sy=fy*fy*(3.0-2.0*fy),sz=fz*fz*(3.0-2.0*fz);
    float c000=vhashf(xi,yi,zi),c100=vhashf(xi+1,yi,zi),c010=vhashf(xi,yi+1,zi),c110=vhashf(xi+1,yi+1,zi);
    float c001=vhashf(xi,yi,zi+1),c101=vhashf(xi+1,yi,zi+1),c011=vhashf(xi,yi+1,zi+1),c111=vhashf(xi+1,yi+1,zi+1);
    float x00=mix(c000,c100,sx),x10=mix(c010,c110,sx),x01=mix(c001,c101,sx),x11=mix(c011,c111,sx);
    float y0=mix(x00,x10,sy),y1=mix(x01,x11,sy);
