vec3 texNormalRaw(int id, vec2 uv){
    int b=uRectOff+id*RECT;
    int x=wrapTexel(uv.x,int(aux[b+2])), y=wrapTexel(uv.y,int(aux[b+3]));
    vec3 c=texelFetch(uAtlas, ivec2(int(aux[b])+x, int(aux[b+1])+y), 0).rgb;
    return c*2.0-1.0;
}
// the object-space vector v into the world through instance ib's transform
vec3 instToWorld(int ib, vec3 v){ return vec3(top[ib+12]*v.x+top[ib+13]*v.y+top[ib+14]*v.z, top[ib+15]*v.x+top[ib+16]*v.y+top[ib+17]*v.z, top[ib+18]*v.x+top[ib+19]*v.y+top[ib+20]*v.z); }
// tangent-space normal map on the front of the hit triangle (n: its winding normal): a tangent frame from the
// triangle's edges and UV gradients (taken into the world by the instance's transform), the decoded RGB normal
// rotated into it. Green runs along n x tangent, or down the image (the texture's v) for a map in the DirectX
// convention (dx).
vec3 texNormal(int inst, int tri, vec3 n, int texId, vec2 uv, bool dx){
    if(!hasRect(texId)) return n;
    int ib=uInstOff+inst*INST, b=uTriOff+tri*TRI;
    vec3 e1=vec3(geo[b+3],geo[b+4],geo[b+5]), e2=vec3(geo[b+6],geo[b+7],geo[b+8]);
    float du1=geo[b+11]-geo[b+9], dv1=geo[b+12]-geo[b+10], du2=geo[b+13]-geo[b+9], dv2=geo[b+14]-geo[b+10];
    float det=du1*dv2-du2*dv1; if(abs(det)<1e-12) return n;
