// prim: the analytic primitive hit, or -1
struct Hit { float t; vec3 p; vec3 n; int mat; bool hasUV; vec2 uv; int tex; float shade; vec3 fall; int ti; int inst; int prim; };

uint hashu(uint x){ x^=x>>16; x*=0x7feb352du; x^=x>>15; x*=0x846ca68bu; x^=x>>16; return x; }
float nextd(inout uint s){ s^=s<<13; s^=s>>17; s^=s<<5; return float(s & 0xffffffu)/16777216.0; }
// normalize that gives a zero vector back unchanged instead of NaN, like the CPU tracer's Norm
vec3 safeNorm(vec3 v){ float l2=dot(v,v); return l2>1e-36 ? v*inversesqrt(l2) : v; }
// self-intersection offset at p: 1e-4 near the origin, growing with the coordinates as the float spacing does
float rayEps(vec3 p){ return max(1e-4, 1e-5*max(abs(p.x),max(abs(p.y),abs(p.z)))); }

vec3 sky(vec3 d){ float t=clamp(0.5*(d.y+1.0),0.0,1.0); return mix(uSkyB,uSkyT,t)*uSkyStrength; }

bool emissiveMat(int m){ return m>=0 && m<uNumMat && int(aux[m*MTL])==3; }
// atlas slot id holds a registered texture
bool hasRect(int id){ return id>=0 && id<uNumRect && aux[uRectOff+id*RECT+2]>=1.0 && aux[uRectOff+id*RECT+3]>=1.0; }
// texel 0..n-1 for texture coordinate u with repeat wrap (the CPU tracer's WrapTexel)
int wrapTexel(float u, int n){ return clamp(int((u-floor(u))*float(n)), 0, n-1); }
vec3 sampleAlbedo(int id, vec2 uv){
    int b=uRectOff+id*RECT;
    int x=wrapTexel(uv.x,int(aux[b+2])), y=wrapTexel(uv.y,int(aux[b+3]));
    vec3 c=texelFetch(uAtlas, ivec2(int(aux[b])+x, int(aux[b+1])+y), 0).rgb;
    return pow(max(c,vec3(0.0)), vec3(2.2));
}

bool boxHit(vec3 o, vec3 d, vec3 bmin, vec3 bmax, float tmin, float tmax, out float t, out vec3 n){
    t=0.0; n=vec3(0.0);
    float tx1=(bmin.x-o.x)/d.x, tx2=(bmax.x-o.x)/d.x;
    float tlo=min(tx1,tx2), thi=max(tx1,tx2); int axis=0; float sgn=(tx1>tx2)?1.0:-1.0;
    float ty1=(bmin.y-o.y)/d.y, ty2=(bmax.y-o.y)/d.y;
    float tylo=min(ty1,ty2), tyhi=max(ty1,ty2);
    if(tylo>tlo){ tlo=tylo; axis=1; sgn=(ty1>ty2)?1.0:-1.0; }
    thi=min(thi,tyhi);
    float tz1=(bmin.z-o.z)/d.z, tz2=(bmax.z-o.z)/d.z;
    float tzlo=min(tz1,tz2), tzhi=max(tz1,tz2);
    if(tzlo>tlo){ tlo=tzlo; axis=2; sgn=(tz1>tz2)?1.0:-1.0; }
    thi=min(thi,tzhi);
    if(thi<tlo||thi<tmin) return false;
    bool ent=tlo>tmin;
    float tt=ent?tlo:thi;
    if(tt<=tmin||tt>=tmax) return false;
    t=tt; float sg=ent?sgn:-sgn;
    n = (axis==0)?vec3(sg,0.0,0.0):((axis==1)?vec3(0.0,sg,0.0):vec3(0.0,0.0,sg));
    return true;
}

// ---- BVH traversal (RtScene.ClosestTri / AnyTri on the CPU, line by line) ----
// 1/d with no zero component, so a slab test never multiplies 0 by infinity
float safeInv(float v){ return 1.0/(v>=0.0 ? max(v,1e-20) : min(v,-1e-20)); }
vec3 invDir(vec3 d){ return vec3(safeInv(d.x),safeInv(d.y),safeInv(d.z)); }
// entry distance of the ray into the box, or NOHIT when it misses it within [tmin, tmax]
float slab(vec3 bmin, vec3 bmax, vec3 o, vec3 id, float tmin, float tmax){
    vec3 t0=(bmin-o)*id, t1=(bmax-o)*id;
    vec3 lo=min(t0,t1), hi=max(t0,t1);
    float a=max(max(lo.x,lo.y),max(lo.z,tmin)), c=min(min(hi.x,hi.y),min(hi.z,tmax));
    return a<=c*BOX_SLACK ? a : NOHIT;
}
// box test of node n of the bottom levels (Geo) and of the top level (Top)
float geoSlab(int n, vec3 o, vec3 id, float tmin, float tmax){ int b=n*NODE; return slab(vec3(geo[b],geo[b+1],geo[b+2]), vec3(geo[b+3],geo[b+4],geo[b+5]), o, id, tmin, tmax); }
float topSlab(int n, vec3 o, vec3 id, float tmin, float tmax){ int b=uTlasOff+n*NODE; return slab(vec3(top[b],top[b+1],top[b+2]), vec3(top[b+3],top[b+4],top[b+5]), o, id, tmin, tmax); }
// Moller-Trumbore against triangle k (object space; d need not be unit length, dl is its length), t in (tmin, tmax)
bool triHit(int k, vec3 o, vec3 d, float dl, float tmin, float tmax, out float t, out float u, out float v){
    int b=uTriOff+k*TRI;
    vec3 e1=vec3(geo[b+3],geo[b+4],geo[b+5]), e2=vec3(geo[b+6],geo[b+7],geo[b+8]);
    vec3 pv=cross(d,e2); float det=dot(e1,pv);
    t=0.0; u=0.0; v=0.0;
    if(abs(det)<=DET_EPS*dl*geo[b+17]) return false;
    float idet=1.0/det;
    vec3 tv=o-vec3(geo[b],geo[b+1],geo[b+2]); u=dot(tv,pv)*idet; if(u<0.0||u>1.0) return false;
    vec3 qv=cross(tv,e1); v=dot(d,qv)*idet; if(v<0.0||u+v>1.0) return false;
    t=dot(e2,qv)*idet;
    return t>tmin && t<tmax;
}
// the world ray in instance ib's own space
vec3 instPoint(int ib, vec3 p){ return vec3(top[ib]*p.x+top[ib+1]*p.y+top[ib+2]*p.z+top[ib+3], top[ib+4]*p.x+top[ib+5]*p.y+top[ib+6]*p.z+top[ib+7], top[ib+8]*p.x+top[ib+9]*p.y+top[ib+10]*p.z+top[ib+11]); }
vec3 instDir(int ib, vec3 d){ return vec3(top[ib]*d.x+top[ib+1]*d.y+top[ib+2]*d.z, top[ib+4]*d.x+top[ib+5]*d.y+top[ib+6]*d.z, top[ib+8]*d.x+top[ib+9]*d.y+top[ib+10]*d.z); }
#ifdef HAS_CUT
// whether the hit at barycentrics (u, v) of triangle k lands on a hole of its texture or sprite: a texel whose alpha
// is under cut (the instance's alpha cut), or any texel of a sprite that is not registered
bool cutOut(int k, float u, float v, float cut){
    int b=uTriOff+k*TRI; int slot=int(geo[b+16]);
    if(slot<0 || slot>=uNumRect) return false;
    int r=uRectOff+slot*RECT; float mode=aux[r+4];
    if(mode<0.5) return false;
    if(mode>1.5) return true;
    if(aux[r+2]<1.0 || aux[r+3]<1.0) return false;
    float w=1.0-u-v;
    vec2 uv=vec2(geo[b+9]*w+geo[b+11]*u+geo[b+13]*v, geo[b+10]*w+geo[b+12]*u+geo[b+14]*v);
    int x=wrapTexel(uv.x,int(aux[r+2])), y=wrapTexel(uv.y,int(aux[r+3]));
    return texelFetch(uAtlas, ivec2(int(aux[r])+x, int(aux[r+1])+y), 0).a < cut;
}
#else
bool cutOut(int k, float u, float v, float cut){ return false; }
#endif

// The nearest triangle a world ray hits with t in (tmin, tbest): on a hit tbest becomes its distance and hInst,
// hTri, hu, hv name it. One stack serves both levels: the build keeps the top level within 16 levels and every
// object's tree within 32, so it never overflows.
bool closestTri(vec3 o, vec3 d, float tmin, inout float tbest, out int hInst, out int hTri, out float hu, out float hv){
    hInst=-1; hTri=-1; hu=0.0; hv=0.0;
    if(uNumInst==0) return false;
    int st[STK]; int sp=0, node=0;
    vec3 id=invDir(d);
    while(true){
        int b=uTlasOff+node*NODE;
        int cnt=int(top[b+7]);
        if(cnt>0){
            int first=int(top[b+6]);
            for(int k=0;k<cnt;k++){
                int ib=uInstOff+(first+k)*INST;
                vec3 lo=instPoint(ib,o), ld=instDir(ib,d), lid=invDir(ld);
                float dl=length(ld);
                int nb=int(top[ib+21]), tb=int(top[ib+22]);
                float cut=top[ib+37];
                if(geoSlab(nb,lo,lid,tmin,tbest)>=NOHIT) continue;
                int bas=sp, bn=0;
                while(true){
                    int c=(nb+bn)*NODE;
                    int bc=int(geo[c+7]), bf=int(geo[c+6]);
                    if(bc>0){
                        for(int j=0;j<bc;j++){
                            float tt,uu,vv;
                            if(triHit(tb+bf+j,lo,ld,dl,tmin,tbest,tt,uu,vv) && !cutOut(tb+bf+j,uu,vv,cut)){ tbest=tt; hInst=first+k; hTri=tb+bf+j; hu=uu; hv=vv; }
                        }
                    } else {
                        float d1=geoSlab(nb+bf,lo,lid,tmin,tbest), d2=geoSlab(nb+bf+1,lo,lid,tmin,tbest);
                        int n1=bf, n2=bf+1;
                        if(d2<d1){ float x=d1; d1=d2; d2=x; n1=bf+1; n2=bf; }
                        if(d1<NOHIT){
                            if(d2<NOHIT && sp<STK) st[sp++]=n2;
                            bn=n1; continue;
                        }
                    }
                    if(sp==bas) break;
                    bn=st[--sp];
                }
            }
        } else {
            int l=int(top[b+6]);
            float d1=topSlab(l,o,id,tmin,tbest), d2=topSlab(l+1,o,id,tmin,tbest);
            int n1=l, n2=l+1;
            if(d2<d1){ float x=d1; d1=d2; d2=x; n1=l+1; n2=l; }
            if(d1<NOHIT){
                if(d2<NOHIT && sp<STK) st[sp++]=n2;
                node=n1; continue;
            }
        }
        if(sp==0) break;
        node=st[--sp];
    }
    return hInst>=0;
}

// Whether a world ray hits any triangle with t in (tmin, tmax). The holes of textures and sprites let it through,
// and with passEmis so do instances with an emissive material (on a ray toward a light they stand for).
bool anyTri(vec3 o, vec3 d, float tmin, float tmax, bool passEmis){
    if(uNumInst==0) return false;
    int st[STK]; int sp=0, node=0;
    vec3 id=invDir(d);
    while(true){
        int b=uTlasOff+node*NODE;
        int cnt=int(top[b+7]);
        if(cnt>0){
            int first=int(top[b+6]);
            for(int k=0;k<cnt;k++){
                int ib=uInstOff+(first+k)*INST;
                if(passEmis && emissiveMat(int(top[ib+23]))) continue;
                vec3 lo=instPoint(ib,o), ld=instDir(ib,d), lid=invDir(ld);
                float dl=length(ld);
                int nb=int(top[ib+21]), tb=int(top[ib+22]);
                float cut=top[ib+37];
                if(geoSlab(nb,lo,lid,tmin,tmax)>=NOHIT) continue;
                int bas=sp, bn=0;
                while(true){
                    int c=(nb+bn)*NODE;
                    int bc=int(geo[c+7]), bf=int(geo[c+6]);
                    if(bc>0){
                        for(int j=0;j<bc;j++){
                            float tt,uu,vv;
                            if(triHit(tb+bf+j,lo,ld,dl,tmin,tmax,tt,uu,vv) && !cutOut(tb+bf+j,uu,vv,cut)) return true;
                        }
                    } else {
                        bool h1=geoSlab(nb+bf,lo,lid,tmin,tmax)<NOHIT, h2=geoSlab(nb+bf+1,lo,lid,tmin,tmax)<NOHIT;
                        if(h1 || h2){
                            if(h1 && h2 && sp<STK) st[sp++]=bf+1;
                            bn=h1 ? bf : bf+1; continue;
                        }
                    }
                    if(sp==bas) break;
                    bn=st[--sp];
                }
            }
        } else {
            int l=int(top[b+6]);
            bool h1=topSlab(l,o,id,tmin,tmax)<NOHIT, h2=topSlab(l+1,o,id,tmin,tmax)<NOHIT;
            if(h1 || h2){
                if(h1 && h2 && sp<STK) st[sp++]=l+1;
                node=h1 ? l : l+1; continue;
            }
        }
        if(sp==0) break;
        node=st[--sp];
    }
    return false;
}

#ifdef HAS_SDF
// ---- SDF primitives (Kind 3 torus, Kind 4 presets), each marched inside its own bounding sphere ----
float torusSDF(vec3 q, float R, float r, int axis){
    float a,b;
    if(axis==0){ a=sqrt(q.y*q.y+q.z*q.z)-R; b=q.x; }
    else if(axis==2){ a=sqrt(q.x*q.x+q.y*q.y)-R; b=q.z; }
    else { a=sqrt(q.x*q.x+q.z*q.z)-R; b=q.y; }
    return sqrt(a*a+b*b)-r;
}
float gemSDF(vec3 q, float A){
    float s=1.0/max(A,1e-3); vec3 p=q*s; float d=-1e30;
    for(int i=0;i<33;i++){ vec4 f=GEM[i]; d=max(d, f.x*p.x+f.y*p.y+f.z*p.z-f.w); }
    return d*A;
}
float primSDF(int b, vec3 p){
    vec3 c=vec3(top[b+1],top[b+2],top[b+3]); vec3 q=p-c;
    int kind=int(top[b]); float A=top[b+4], B=top[b+5], C=top[b+6];
    if(kind==3) return torusSDF(q,A,B,int(C));
    int preset=int(top[b+13]);
    if(preset==1){ float r=0.15*A; float dx=abs(q.x)-(A-r), dy=abs(q.y)-(B-r), dz=abs(q.z)-(C-r);
        float ox=max(dx,0.0),oy=max(dy,0.0),oz=max(dz,0.0);
        return sqrt(ox*ox+oy*oy+oz*oz)+min(max(dx,max(dy,dz)),0.0)-r; }
    if(preset==2) return torusSDF(q,A,B,1);
    if(preset==3){ float yy=q.y; if(yy>A) yy-=A; else if(yy<-A) yy+=A; else yy=0.0; return sqrt(q.x*q.x+yy*yy+q.z*q.z)-B; }
    if(preset==4){ float f=1.0/max(A,1e-3); float g=sin(q.x*f)*cos(q.y*f)+sin(q.y*f)*cos(q.z*f)+sin(q.z*f)*cos(q.x*f);
        float shell=(abs(g)-0.25)*A*0.5; float bound=length(q)-A*2.2; return max(shell,bound); }
    if(preset==5){ float m=abs(q.x)+abs(q.y)+abs(q.z)-A; return m*0.57735026; }
    if(preset==6) return gemSDF(q,A);
    return length(q)-A;
}
// sphere-trace the primitive at b between where the ray enters and leaves its bounding sphere, clipped to [tmin, tmax)
bool marchPrim(int b, vec3 o, vec3 d, float tmin, float tmax, out float tHit){
    tHit=0.0;
    vec3 oc=o-vec3(top[b+1],top[b+2],top[b+3]); float R=top[b+15];
    float bb=dot(oc,d), disc=bb*bb-(dot(oc,oc)-R*R);
    if(disc<0.0) return false;
    float sq=sqrt(disc);
    float t=max(tmin,-bb-sq), t1=min(tmax,-bb+sq);
    if(t>=t1) return false;
    // +1 outside the solid, -1 when the ray starts inside it (a refracted ray in the glass diamond): stepping by
    // sign*dist always advances toward the next boundary
    float s0=(primSDF(b,o+d*t)<0.0)?-1.0:1.0;
    for(int i=0;i<160 && t<t1;i++){
        float dist=primSDF(b,o+d*t);
        if(abs(dist)<1e-4*(1.0+t)){ tHit=t; return true; }
        t+=s0*dist;
    }
    return false;
}
// tetrahedral gradient of the primitive's SDF: four samples
vec3 primNormal(int b, vec3 p){
    const float e=5e-4;
    vec3 k0=vec3(1.0,-1.0,-1.0), k1=vec3(-1.0,-1.0,1.0), k2=vec3(-1.0,1.0,-1.0), k3=vec3(1.0,1.0,1.0);
    return safeNorm(k0*primSDF(b,p+k0*e)+k1*primSDF(b,p+k1*e)+k2*primSDF(b,p+k2*e)+k3*primSDF(b,p+k3*e));
}
// the nearest SDF surface in [tmin, tmax), its normal and material
bool marchHit(vec3 o, vec3 d, float tmin, float tmax, out float tHit, out vec3 n, out int mat){
    tHit=0.0; n=vec3(0.0); mat=-1; int hb=-1;
    for(int i=0;i<uNumPrim;i++){
        int b=i*PRM; if(int(top[b])<3) continue;
        float t; if(marchPrim(b,o,d,tmin,tmax,t)){ tmax=t; tHit=t; hb=b; }
    }
    if(hb<0) return false;
    n=primNormal(hb,o+d*tHit); mat=int(top[hb+14]); return true;
}
// shadow rays: with passEmis, SDF shapes with an emissive material let them through
bool marchAny(vec3 o, vec3 d, float tmin, float tmax, bool passEmis){
    for(int i=0;i<uNumPrim;i++){
        int b=i*PRM; if(int(top[b])<3 || (passEmis && emissiveMat(int(top[b+14])))) continue;
        float t; if(marchPrim(b,o,d,tmin,tmax,t)) return true;
    }
    return false;
}
