vec3 woodAlbedo(vec3 p, vec3 baseAlb){
    float rad=sqrt(p.x*p.x+p.z*p.z); float rings=sin(rad*14.0+sin(p.y*3.0)*1.5);
    float f=0.55+0.45*(rings*0.5+0.5); return baseAlb*f;
