vec3 cosineHemisphere(vec3 n, inout uint seed){
    float r1=nextd(seed), r2=nextd(seed);
    float r=sqrt(r1), phi=2.0*PI*r2;
    float x=r*cos(phi), y=r*sin(phi), z=sqrt(max(0.0,1.0-r1));
    vec3 u, v; frame(n,u,v);
    return safeNorm(u*x+v*y+n*z);
}
// Smith's Lambda for GGX roughness a and a direction at cosine c to the normal
float smithLambda(float c, float a){ float c2=max(c*c,1e-12); return 0.5*(sqrt(1.0+a*a*(1.0-c2)/c2)-1.0); }
// A rough-metal bounce: a GGX microfacet normal drawn from those the view v (toward the eye, above n) sees (Heitz
// 2018), and v mirrored about it. w is the bounce's weight G2/G1; 0 when the bounce leaves below n.
vec3 ggxReflect(vec3 v, vec3 n, float a, inout uint seed, out float w){
    vec3 t1, t2; frame(n,t1,t2);
    vec3 vl=vec3(dot(v,t1),dot(v,t2),dot(v,n));
    vec3 vh=safeNorm(vec3(a*vl.x,a*vl.y,vl.z));
    float l2=vh.x*vh.x+vh.y*vh.y;
    vec3 b1=l2>0.0 ? vec3(-vh.y,vh.x,0.0)*inversesqrt(l2) : vec3(1.0,0.0,0.0), b2=cross(vh,b1);
    float r=sqrt(nextd(seed)), ph=2.0*PI*nextd(seed);
    float p1=r*cos(ph), p2=r*sin(ph), s=0.5*(1.0+vh.z);
    p2=(1.0-s)*sqrt(max(0.0,1.0-p1*p1))+s*p2;
    vec3 nh=b1*p1+b2*p2+vh*sqrt(max(0.0,1.0-p1*p1-p2*p2));
    vec3 m=safeNorm(vec3(a*nh.x,a*nh.y,max(nh.z,0.0)));
    vec3 ll=reflect(-vl,m);
    if(ll.z<=0.0){ w=0.0; return n; }
    float lv=smithLambda(vl.z,a), lw=smithLambda(ll.z,a);
    w=(1.0+lv)/(1.0+lv+lw);
    return safeNorm(t1*ll.x+t2*ll.y+n*ll.z);
}

// The hit's material: type, albedo (with the object's colour override or tint), emission (the material's plus the
// object's emissive), roughness, IOR and normal map (normTex: a texture slot; dx: its green runs down the image).
void resolve(Hit h, out int type, out vec3 alb, out vec3 emis, out float rough, out float ior, out int nmap, out int normTex, out bool dx){
    type=0; rough=1.0; ior=1.5; nmap=0; normTex=-1; dx=false; emis=vec3(0.0); alb=vec3(0.8);
    bool texd=false; float sh=1.0;
    if(h.mat>=0 && h.mat<uNumMat){
        int b=h.mat*MTL;   // materials live at the start of the aux buffer (offset 0)
        type=int(aux[b]); rough=aux[b+4]; ior=aux[b+5]; nmap=int(aux[b+10]); normTex=int(aux[b+11]);
        emis=vec3(aux[b+6],aux[b+7],aux[b+8]);
        int mtex=int(aux[b+9]);
        if(h.hasUV && hasRect(mtex)){ alb=sampleAlbedo(mtex, h.uv); texd=true; }
        else alb=vec3(aux[b+1],aux[b+2],aux[b+3]);   // no texture, or one that isn't registered: the material colour
    } else if(hasRect(h.tex)){
        sh=h.shade; alb=sampleAlbedo(h.tex, h.uv)*sh; texd=true;
    } else {
        alb=h.fall;
    }
    if(h.inst>=0){
        int ib=uInstOff+h.inst*INST;
        if(top[ib+31]>=0.0) alb=vec3(top[ib+31],top[ib+32],top[ib+33])*sh;
        else if(texd) alb*=vec3(top[ib+28],top[ib+29],top[ib+30]);
        emis+=alb*vec3(top[ib+34],top[ib+35],top[ib+36]);
        // the normal map SetTextureNormalMap gave the triangle's texture, when the material has none
        if(normTex<0 && nmap==0 && hasRect(h.tex)){ int ns=int(aux[uRectOff+h.tex*RECT+5]); if(ns>=0){ normTex=ns; dx=true; } }
    }
}

vec3 trace(vec3 o, vec3 d, inout uint seed){
    vec3 L=vec3(0.0), thr=vec3(1.0);
    float tmin=rayEps(o);
    // the last diffuse vertex, whose directLight sampled the emissive spheres: its point and normals
    bool pd=false; vec3 pp=vec3(0.0), pn=vec3(0.0), pnf=vec3(0.0);
    bool lit=false;   // a diffuse vertex on the path: rays escaping after it bring the ambient light
    for(int bounce=0; bounce<MAXD; bounce++){
        Hit h; h.t=NOHIT; h.ti=-1; h.inst=-1; h.prim=-1; h.mat=-1; h.hasUV=false; h.tex=-1; h.shade=1.0; h.fall=vec3(0.8); h.uv=vec2(0.0); h.p=vec3(0.0); h.n=vec3(0.0,1.0,0.0);
        if(!closest(o,d,tmin,h)){ L+=thr*(sky(d) + (lit ? uAmb : vec3(0.0))); break; }   // the camera and its mirrors see the plain sky
        int type,nmap,normTex; vec3 alb,emis; float rough,ior; bool dx;
        resolve(h,type,alb,emis,rough,ior,nmap,normTex,dx);
        vec3 ng=h.n; float cosI=-dot(d,ng); bool inside=cosI<0.0;
        vec3 nf = inside ? -ng : ng;   // the surface normal on the ray's side: ray offsets and the side checks use it
        vec3 n = nf;                   // the shading normal
#ifdef HAS_NMAP
        if(normTex>=0 && h.ti>=0){ n=texNormal(h.inst,h.ti,ng,normTex,h.uv,dx); if(inside) n=-n; }
        else if(nmap!=0){ if(nmap==1) alb=woodAlbedo(h.p,alb); n=perturbNormal(h.p,nf,nmap); }
#endif
        L+=thr*emis*((pd && type==3 && h.prim>=0) ? bounceWeight(h.prim,pp,pn,pnf,d) : 1.0);
        if(type==3) break;
        vec3 p=h.p; float e=rayEps(p); tmin=e;
        pd=false;
        if(type==2){
            float eta = inside ? ior : 1.0/ior;
            float c=-dot(d,n);
            if(c<=0.0){ n=nf; c=abs(cosI); }   // a bent normal facing away from the ray: the surface's own
            float k=1.0-eta*eta*(1.0-c*c);
            vec3 refl=above(reflect(d,n),nf);
            if(k<0.0){ o=p+nf*e; d=refl; }
            else {
                float cosT=sqrt(k);
                float r0=(eta-1.0)/(eta+1.0); r0*=r0;
                float cs=(eta>1.0)?cosT:c;   // Schlick takes the cosine on the thinner side
                float fr=r0+(1.0-r0)*pow(1.0-cs,5.0);
                if(nextd(seed)<fr){ o=p+nf*e; d=refl; }
                else { o=p-nf*e; d=-above(-safeNorm(d*eta + n*(eta*c-cosT)),nf); }
            }
            thr*=alb;
        } else if(type==1){
            if(dot(d,n)>=0.0) n=nf;   // a bent normal facing away from the ray: the surface's own
            if(rough>0.0){
                float w; d=ggxReflect(-d,n,max(rough*rough,1e-4),seed,w);
                if(w<=0.0) break;
                thr*=alb*w;
            } else { d=reflect(d,n); thr*=alb; }
            d=above(d,nf); o=p+nf*e;
        } else {
            L+=thr*alb*directLight(p,n,nf,e,seed);
            d=above(cosineHemisphere(n,seed),nf);
            pd=true; lit=true; pp=p; pn=n; pnf=nf;
            o=p+nf*e; thr*=alb;
        }
        if(bounce>=3){
            float q=max(thr.x,max(thr.y,thr.z));
            if(q<1.0){ if(nextd(seed)>q) break; thr*=1.0/max(q,1e-4); }
        }
    }
    return L;
}

void main(){
    ivec2 gid=ivec2(gl_GlobalInvocationID.xy)+ivec2(0,uRowOff);
    if(gid.x>=uW || gid.y>=uH) return;
    vec4 prev=(uReset!=0) ? vec4(0.0) : imageLoad(uPrev, gid);   // the first frame after a reset starts from zero
    // rows outside this frame's band, and three pixels of every 2x2 block in a heavy scene's moving pass, keep their sum
    if(gid.y<uTraceY0 || gid.y>=uTraceY1 || (uHalf!=0 && ((gid.x|gid.y)&1)!=0)){ imageStore(uOut, gid, prev); return; }
    int px=gid.x, py=gid.y;
    uint idx=uint(py*uW+px);
    float hw=float(uW)*0.5, hh=float(uH)*0.5;
    uint n0=uint(prev.a);
    vec3 sum=vec3(0.0);
    for(int sp=0; sp<uSPP; sp++){
        uint si=n0+uint(sp)+1u;                         // 1-based sample index of this pixel (matches the CPU seed)
        uint seed=hashu(idx*2654435761u ^ si*40503u) | 1u;   // xorshift stays at 0 from a 0 seed
        float jx=nextd(seed), jy=nextd(seed);
        float sx=(float(px)+jx-hw)/uScale;
        float sy=-(float(py)+jy-hh)/uScale;
        vec3 dir=safeNorm(uR*sx + uU*sy + uF);
        vec3 c=trace(uEye, dir, seed);
        float cs=c.x+c.y+c.z;
        if(!isnan(cs) && !isinf(cs)) sum += c;   // a NaN would stay in the sum until the next reset
    }
    imageStore(uOut, gid, vec4(prev.rgb+sum, prev.a+float(uSPP)));
}