#version 310 es
precision highp float;
precision highp int;
layout(local_size_x=8, local_size_y=8) in;
// GLES forbids readwrite on rgba32f images -- ping-pong a readonly previous + a writeonly output image.
// rgb is the radiance sum, a the number of samples in it.
layout(rgba32f, binding=0) readonly  uniform highp image2D uPrev;
layout(rgba32f, binding=1) writeonly uniform highp image2D uOut;

// Geo: [bottom-level BVH nodes of every object][object-space triangles]. Top: [primitives][instances][top-level
// BVH nodes]. Aux: [materials][lights][texture slots]. GLES 3.1 only guarantees 4 compute storage blocks
// (ANGLE/D3D11 maps SSBOs to UAVs), so the data stays in 3: 5 separate SSBOs failed to link on ANGLE.
layout(std430, binding=1) readonly buffer Geo { float geo[]; };
layout(std430, binding=2) readonly buffer Top { float top[]; };
layout(std430, binding=3) readonly buffer Aux { float aux[]; };
uniform highp sampler2D uAtlas;

uniform vec3 uEye, uR, uU, uF;
uniform int uW, uH, uSPP, uReset, uHalf, uRowOff, uTraceY0, uTraceY1;
uniform float uScale;
uniform int uTriOff, uNumInst, uInstOff, uTlasOff;
uniform int uNumPrim, uNumMat, uNumLight, uNumRect, uLightOff, uRectOff;
uniform vec3 uSkyB, uSkyT; uniform float uSkyStrength;
uniform vec3 uSunDir, uSunCol, uAmb;   // directional sun (direction toward it), ambient light from every direction

const int TRI=18, NODE=8, INST=38, PRM=16, MTL=12, LGT=6, RECT=6, MAXD=8, STK=48;
const float BOX_SLACK=1.000001, DET_EPS=0.0000001, NOHIT=1e30;
const float PI=3.14159265358979;
const float MIN_LIGHT_D2=1e-4;   // light samples nearer than 1 cm count as 1 cm away
#ifdef HAS_SDF
