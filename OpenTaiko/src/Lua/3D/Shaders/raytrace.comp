    float mt; vec3 mn; int mm;
    if(marchHit(o,d,tmin,h.t,mt,mn,mm)){ h.t=mt; hit=true; h.p=o+d*mt; h.n=mn; h.mat=mm; h.hasUV=false; h.tex=-1; h.ti=-1; h.inst=-1; h.prim=-1; }
#endif
