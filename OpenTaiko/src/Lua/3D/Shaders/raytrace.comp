bool closest(vec3 o, vec3 d, float tmin, inout Hit h){
    bool hit=false;
    int hi, ht; float hu, hv;
    if(closestTri(o,d,tmin,h.t,hi,ht,hu,hv)){
        int ib=uInstOff+hi*INST, b=uTriOff+ht*TRI;
        hit=true; h.p=o+d*h.t;
        vec3 n=cross(vec3(geo[b+3],geo[b+4],geo[b+5]), vec3(geo[b+6],geo[b+7],geo[b+8]));
        // the object-space normal through the inverse transpose; the sign keeps the world winding of a mirroring transform
        h.n=safeNorm((vec3(top[ib],top[ib+1],top[ib+2])*n.x + vec3(top[ib+4],top[ib+5],top[ib+6])*n.y
            + vec3(top[ib+8],top[ib+9],top[ib+10])*n.z)*top[ib+27]);
        h.mat=int(top[ib+23]); h.fall=vec3(top[ib+24],top[ib+25],top[ib+26]);
        h.shade=geo[b+15]; h.tex=int(geo[b+16]); h.hasUV=hasRect(h.tex);
        float w=1.0-hu-hv;
        h.uv=vec2(geo[b+9]*w+geo[b+11]*hu+geo[b+13]*hv, geo[b+10]*w+geo[b+12]*hu+geo[b+14]*hv);
        h.ti=ht; h.inst=hi; h.prim=-1;
    }
    for(int i=0;i<uNumPrim;i++){
        int b=i*PRM; int kind=int(top[b]); vec3 c=vec3(top[b+1],top[b+2],top[b+3]);
        if(kind==0){
            float rad=top[b+4]; vec3 oc=o-c; float bb=dot(oc,d), cc=dot(oc,oc)-rad*rad; float disc=bb*bb-cc; if(disc<0.0) continue;
            float sq=sqrt(disc); float tt=-bb-sq; if(tt<=tmin) tt=-bb+sq; if(tt<=tmin||tt>=h.t) continue;
            h.t=tt; hit=true; h.p=o+d*tt; h.n=safeNorm((h.p-c)/rad); h.mat=int(top[b+14]); h.hasUV=false; h.tex=-1; h.ti=-1; h.inst=-1; h.prim=i;
        } else if(kind==1){
            vec3 nrm=vec3(top[b+4],top[b+5],top[b+6]); float den=dot(d,nrm); if(abs(den)<1e-9) continue;
            float tt=dot(c-o,nrm)/den; if(tt<=tmin||tt>=h.t) continue;
            h.t=tt; hit=true; h.p=o+d*tt; h.n=nrm; h.mat=int(top[b+14]); h.hasUV=false; h.tex=-1; h.ti=-1; h.inst=-1; h.prim=i;
        } else if(kind==2){
            vec3 bmin=vec3(top[b+7],top[b+8],top[b+9]), bmax=vec3(top[b+10],top[b+11],top[b+12]);
            float tt; vec3 bn;
            if(boxHit(o,d,bmin,bmax,tmin,h.t,tt,bn)){ h.t=tt; hit=true; h.p=o+d*tt; h.n=bn; h.mat=int(top[b+14]); h.hasUV=false; h.tex=-1; h.ti=-1; h.inst=-1; h.prim=i; }
        }
    }
